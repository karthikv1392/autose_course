<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#173f73" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0b1424" media="(prefers-color-scheme: dark)">
    <title>{% if title %}{{ title }} · {% endif %}{{ site.shortName }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="author" content="{{ course.instructor }}">
    <link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
  </head>
  <body class="libdoc-body">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="libdoc-frame">
      <aside class="libdoc-sidebar">
        <a class="libdoc-brand" href="{{ '/' | url }}" aria-label="{{ site.name }}, home">{{ site.shortName }}</a>
        <p class="libdoc-term">{{ site.semester }}<br>{{ site.institution }}</p>
        <nav aria-label="Course sections">
          <ul class="libdoc-nav">
            {% for item in site.navigation %}
              {% if item.children %}
                {% set groupActive = false %}
                {% for child in item.children %}{% if page.url == child.url %}{% set groupActive = true %}{% endif %}{% endfor %}
                <li>
                  <details class="libdoc-nav-group"{% if groupActive %} open{% endif %}>
                    <summary{% if groupActive %} class="is-active"{% endif %}>{{ item.label }}</summary>
                    <ul class="libdoc-subnav">
                      {% for child in item.children %}
                        <li><a href="{{ child.url | url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
                      {% endfor %}
                    </ul>
                  </details>
                </li>
              {% else %}
                <li><a href="{{ item.url | url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </nav>
      </aside>
      <div class="libdoc-content">
        <main id="main-content">
          <div class="libdoc-main">
            {{ content | safe }}
          </div>
        </main>
        <footer class="libdoc-footer">
          <a href="https://karthikvaidhyanathan.com" rel="me">Copyright © Karthik Vaidhyanathan</a>
          <span>This site is cleaner than <a href="https://www.websitecarbon.com/website/karthikv1392-github-io-autose_course-team/">99%</a> of all web pages globally.</span>
          <span>Inspired by <a href="https://eleventy-libdoc.netlify.app/">Eleventy LibDoc</a></span>
        </footer>
      </div>
    </div>
  </body>
</html>
